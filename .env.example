APP_NAME="AI Content Factory"
APP_VERSION="1.0.0"
DEBUG=false

BASE_DIR="."
DOWNLOAD_DIR="downloads"
OUTPUT_DIR="outputs"
TEMP_DIR="temp"

GROQ_API_KEY=""
LLM_MODEL="llama-3.1-8b-instant"

WHISPER_MODEL="small"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

TARGET_WIDTH=1080
TARGET_HEIGHT=1920
VIDEO_CRF=20
VIDEO_PRESET="fast"
AUDIO_BITRATE="192k"
YTDLP_FORMAT="bestvideo+bestaudio/best"
FFMPEG_BINARY="ffmpeg"
FFPROBE_BINARY="ffprobe"

ENABLE_SUBTITLES=false
SUBTITLE_FONT_SIZE=42
SUBTITLE_POSITION_MARGIN=180

ENABLE_THUMBNAILS=true
THUMBNAIL_WIDTH=1280
THUMBNAIL_HEIGHT=720

ENABLE_PLATFORM_EXPORTS=false
CLIP_SELECTION_COUNT=5
MIN_CLIP_DURATION_SECONDS=1.0
MAX_CLIP_DURATION_SECONDS=90.0

ENABLE_GPU=true
NVIDIA_ENCODER="h264_nvenc"
CPU_ENCODER="libx264"

RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=0.5
RETRY_BACKOFF_MULTIPLIER=2.0

CLEANUP_TEMP_MAX_AGE_HOURS=24
CLEANUP_OUTPUT_MAX_AGE_HOURS=168
CLEANUP_DOWNLOAD_MAX_AGE_HOURS=168
CLEANUP_DELETE_DOWNLOADS=false

STORAGE_BACKEND="local"

# Durable job store (SQLite WAL; mounted at ./data in compose).
JOB_STORE_DB="jobs.db"

# Non-empty JSON array -> POST /jobs* requires header X-API-Key; empty = off.
# e.g. API_KEYS='["rotate-me-after-the-2026-image-bake"]'
API_KEYS=""

# --- YouTube publishing (Data API) -------------------------------------------
# OAuth2 client of a Google Cloud project with the youtube.upload scope.
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""
# YOUTUBE_REFRESH_TOKEN=""
# Default metadata for published videos.
# YOUTUBE_CATEGORY_ID="27"          # Science & Technology
# YOUTUBE_DEFAULT_PRIVACY="private" # private | unlisted | public
# YOUTUBE_TAGS='["ai", "shorts"]'
# YOUTUBE_PUBLISH_MADE_FOR_KIDS=false
# Publish automatically at the end of the pipeline.
# YOUTUBE_PUBLISH_ENABLED=false
# YOUTUBE_UPLOAD_CHUNK_BYTES=8388608
# YOUTUBE_PUBLISH_TIMEOUT_SECONDS=60
